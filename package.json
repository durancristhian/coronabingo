{
    "name": "coronabingo",
    "version": "1.23.1",
    "scripts": {
        "prebuild": "npm run validate-locales",
        "build": "next build --webpack",
        "dev": "next dev --webpack",
        "generate-tickets": "ts-node --project tsconfig.scripts.json scripts/generate-tickets",
        "lint": "npm run typecheck && eslint '*/**/*.{js,ts,tsx}' --quiet --fix",
        "start": "next start",
        "validate-locales": "ts-node --project tsconfig.scripts.json scripts/validate-locales",
        "validate-tickets": "ts-node --project tsconfig.scripts.json scripts/validate-tickets",
        "typecheck": "next typegen && tsc --noEmit",
        "lint:check": "npm run typecheck && eslint '*/**/*.{js,ts,tsx}' --quiet"
    },
    "husky": {
        "hooks": {
            "pre-commit": "npm run validate-locales && npm run typecheck && lint-staged"
        }
    },
    "lint-staged": {
        "*.{js,jsx,ts,tsx}": [
            "eslint --fix"
        ]
    },
    "dependencies": {
        "@ctrl/react-adsense": "^1.1.3",
        "@fullhuman/postcss-purgecss": "^2.1.0",
        "@next/bundle-analyzer": "16.3.6",
        "@sentry/browser": "^5.15.0",
        "@svgr/webpack": "^5.2.0",
        "@types/classnames": "^2.2.10",
        "@types/gsheets": "^2.0.0",
        "@types/node": "24.13.6",
        "@types/react": "18.3.31",
        "@types/react-copy-to-clipboard": "^4.3.0",
        "@types/react-dom": "18.3.7",
        "@types/react-modal": "^3.10.5",
        "@types/react-tabs": "^2.3.1",
        "@types/zipcelx": "^1.5.0",
        "@typescript-eslint/eslint-plugin": "8.70.1",
        "@typescript-eslint/parser": "8.70.1",
        "autoprefixer": "^9.7.4",
        "classnames": "^2.2.6",
        "dotenv": "^8.2.0",
        "eslint": "9.39.5",
        "eslint-config-prettier": "10.1.8",
        "eslint-import-resolver-typescript": "^2.0.0",
        "eslint-plugin-jsx-a11y": "6.10.2",
        "eslint-plugin-prettier": "^3.1.2",
        "eslint-plugin-react": "7.37.5",
        "firebase": "^7.15.5",
        "gsheets": "^1.2.3",
        "husky": "^4.2.3",
        "knuth-shuffle": "^1.0.8",
        "lint-staged": "^10.1.2",
        "next": "16.3.6",
        "next-translate": "3.0.0",
        "next-translate-plugin": "3.0.0",
        "pdf-parse": "^1.1.1",
        "postcss-import": "^12.0.1",
        "prettier": "^1.19.1",
        "react": "18.3.1",
        "react-copy-to-clipboard": "5.1.1",
        "react-dom": "18.3.1",
        "react-icons": "^3.9.0",
        "react-modal": "3.16.3",
        "react-tabs": "4.2.1",
        "react-toastify": "^5.5.0",
        "react-tweet-embed": "^1.2.2",
        "react-youtube": "^7.11.2",
        "swr": "1.3.0",
        "tailwindcss": "^1.4.6",
        "ts-node": "^8.8.2",
        "typescript": "5.9.3",
        "zipcelx": "^1.6.2"
    },
    "license": "MIT",
    "devDependencies": {
        "webpack": "5.111.1"
    },
    "engines": {
        "node": "24.x",
        "npm": "11.x"
    },
    "packageManager": "npm@11.19.0"
}
